[
  {
    "doctype": "Custom Field",
    "name": "Purchase Order-po_type",
    "dt": "Purchase Order",
    "fieldname": "po_type",
    "label": "PO Type",
    "fieldtype": "Select",
    "options": "Normal Material\nSubcontracting/Works\nMachinery Rentals",
    "insert_after": "supplier",
    "reqd": 1
  },
  {
    "doctype": "Custom Field",
    "name": "Purchase Order-approved_by",
    "dt": "Purchase Order",
    "fieldname": "approved_by",
    "label": "Approved By",
    "fieldtype": "Link",
    "options": "User",
    "insert_after": "po_type"
  },
  {
    "doctype": "Custom Field",
    "name": "Purchase Order-approved_technically_by",
    "dt": "Purchase Order",
    "fieldname": "approved_technically_by",
    "label": "Approved Technically By",
    "fieldtype": "Data",
    "insert_after": "approved_by"
  },
  {
    "doctype": "Custom Field",
    "name": "Purchase Order-quotation_no",
    "dt": "Purchase Order",
    "fieldname": "quotation_no",
    "label": "Quotation Number",
    "fieldtype": "Data",
    "insert_after": "supplier",
    "reqd": 0
  },
  {
    "doctype": "Custom Field",
    "name": "Purchase Order-quoatation_date",
    "dt": "Purchase Order",
    "fieldname": "quotation_date",
    "label": "Quotation Date",
    "fieldtype": "Date",
    "fetch_from": "supplier_quotation.transaction_date",
    "fetch_if_empty": 1,
    "insert_after": "quotation_no"
  },
  {
    "doctype": "Custom Field",
    "name": "Purchase Order-delivery_location",
    "dt": "Purchase Order",
    "fieldname": "delivery_location",
    "label": "Delivery Location",
    "fieldtype": "Data",
    "insert_after": "schedule_date"
  },
  {
    "doctype": "Custom Field",
    "name": "Purchase Order-project_contact_person",
    "dt": "Purchase Order",
    "fieldname": "project_contact_person",
    "label": "Contact Person",
    "fieldtype": "Link",
    "options": "User",
    "fetch_from": "project.contact_person",
    "fetch_if_empty": 1,
    "insert_after": "delivery_location"
  },
  {
    "doctype": "Custom Field",
    "name": "Purchase Order-logistics_person",
    "dt": "Purchase Order",
    "fieldname": "logistics_person",
    "label": "Logistics Person",
    "fieldtype": "Link",
    "options": "User",
    "fetch_from": "project.logistics_person",
    "fetch_if_empty": 1,
    "insert_after": "delivery_location"
  },
  {
    "doctype": "Custom Field",
    "name": "Purchase Order-material_request_ref",
    "dt": "Purchase Order",
    "fieldname": "material_request_ref",
    "label": "Material Request Ref",
    "fieldtype": "Data",
    "insert_after": "quotation_date"
  },
  {
    "doctype": "Custom Field",
    "name": "Purchase Order-requested_by",
    "dt": "Purchase Order",
    "fieldname": "requested_by",
    "label": "Requested By",
    "fieldtype": "Data",
    "insert_after": "material_request_ref"
  },
  {
    "doctype": "Custom Field",
    "name": "Project-contact_person",
    "dt": "Project",
    "fieldname": "contact_person",
    "label": "Contact Person",
    "fieldtype": "Link",
    "options": "User",
    "insert_after": "project_name"
  },
  {
    "doctype": "Custom Field",
    "name": "Project-logistics_person",
    "dt": "Project",
    "fieldname": "logistics_person",
    "label": "Logistics Person",
    "fieldtype": "Link",
    "options": "User",
    "insert_after": "contact_person"
  },
  {
    "doctype": "Custom Field",
    "name": "Material Request-custom_type_of_purchase",
    "dt": "Material Request",
    "fieldname": "custom_type_of_purchase",
    "label": "Type of Purchase",
    "fieldtype": "Select",
    "options": "Material Purchase\nMachinery Rental\nSubcontract / Works Request",
    "insert_after": "material_request_type"
  },
  {
    "doctype": "Custom Field",
    "name": "Material Request-custom_attach_document",
    "dt": "Material Request",
    "fieldname": "custom_attach_document",
    "label": "Attach Document",
    "fieldtype": "Attach",
    "insert_after": "custom_type_of_purchase"
  },
  {
    "doctype": "Custom Field",
    "name": "Material Request-custom_comment",
    "dt": "Material Request",
    "fieldname": "custom_comment",
    "label": "Comment",
    "fieldtype": "Small Text",
    "insert_after": "custom_attach_document"
  },
  {
    "doctype": "Custom Field",
    "name": "Material Request-custom_priority_urgency",
    "dt": "Material Request",
    "fieldname": "custom_priority_urgency",
    "label": "Priority / Urgency",
    "fieldtype": "Select",
    "options": "Low\nModerate\nHigh",
    "default": "Moderate",
    "insert_after": "custom_comment"
  },
  {
    "doctype": "Custom Field",
    "name": "Material Request-custom_delivery_location",
    "dt": "Material Request",
    "fieldname": "custom_delivery_location",
    "label": "Delivery Location",
    "fieldtype": "Small Text",
    "insert_after": "schedule_date"
  }
]
